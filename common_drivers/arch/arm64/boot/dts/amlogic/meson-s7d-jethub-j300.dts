 * Identical to U-Boot DTS with kernel-specific includes
 */

/dts-v1/;

#include "meson-s7d.dtsi"

#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	amlogic-dt-id = "s7d_jethub_j300";
	compatible = "jethome,jethub-j300", "amlogic,s7d-txxx", "amlogic,meson-s7d";
	model = "JetHome JetHub D3 mini";

	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart_B;
		ethernet0 = &ethmac;
		mmc0 = &sd_emmc_b;  /* SD card */
        mmc1 = &sd_emmc_c;  /* eMMC */
	};

	chosen {
		stdout-path = "serial0:921600n8";
	};

	/* 4GiB RAM */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x1 0x00000000>;
	};

	/* Minimal stubs required by meson-s7d.dtsi */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		secmon_reserved: secmon { reg = <0x0 0x05000000 0x0 0x2400000>; no-map; };
		logo_reserved: logo { reg = <0x0 0x1f800000 0x0 0x800000>; };
		ion_cma_reserved: ion_cma { size = <0x0 0x0>; };
		ion_fb_reserved: ion_fb { size = <0x0 0x0>; };
		mali_protected: mali { size = <0x0 0x0>; no-map; };
		ppmgr_reserved: ppmgr { size = <0x0 0x0>; };
		codec_mm_cma: codec_cma { size = <0x0 0x0>; };
		codec_mm_reserved: codec_res { size = <0x0 0x0>; };
		secure_vdec_reserved: vdec { size = <0x0 0x0>; no-map; };
	};

	vddio_boot: regulator-vddio-boot {
		compatible = "regulator-fixed";
		regulator-name = "VDDIO_BOOT";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	vddao_3v3: regulator-vddao-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VDDAO_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	vddio_ao18: regulator-vddio-ao18 {
		compatible = "regulator-fixed";
		regulator-name = "VDDIO_AO18";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	vcc_5v: regulator-vcc-5v {
		compatible = "regulator-fixed";
		regulator-name = "VCC_5V";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-boot-on;
		regulator-always-on;
	};

	emmc_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
	};

	gpio-keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		button_up {
			label = "Joystick Up";
			gpios = <&exp24 8 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_UP>;
			debounce-interval = <10>;
		};

		button_down {
			label = "Joystick Down";
			gpios = <&exp24 9 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_DOWN>;
			debounce-interval = <10>;
		};

		button_left {
			label = "Joystick Left";
			gpios = <&exp24 10 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_LEFT>;
			debounce-interval = <10>;
		};

		button_right {
			label = "Joystick Right";
			gpios = <&exp24 11 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_RIGHT>;
			debounce-interval = <10>;
		};

		button_center {
			label = "Joystick Center";
			gpios = <&exp24 12 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_ENTER>;
			debounce-interval = <10>;
		};

		button_home {
			label = "Joystick Home";
			gpios = <&exp24 13 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_HOME>;
			debounce-interval = <10>;
		};

		button_back {
			label = "Joystick Back";
			gpios = <&exp24 14 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_BACK>;
			debounce-interval = <10>;
		};
	};
};

&uart_B {
	status = "okay";
};

/* eMMC */
&sd_emmc_c {
	status = "okay";
	pinctrl-0 = <&emmc_pins>;
	pinctrl-names = "default";

	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	max-frequency = <50000000>;
	non-removable;
	disable-wp;
	card_type = <1>;

	/* Clock phases */
	init_co_phase = <2>;
	init_tx_phase = <0>;

	hs_co_phase = <2>;
	hs_to_phase = <0>;

	hs2_co_phase = <2>;
	hs2_to_phase = <0>;

	/* HW Reset GPIOB_9 */
	hw_reset = <&gpio GPIOB_9 GPIO_ACTIVE_HIGH>;
};

/* SD card */
&sd_emmc_b {
	status = "okay";
	pinctrl-0 = <&sdcard_pins>;
	pinctrl-1 = <&sdcard_clk_gate_pins>;
	pinctrl-2 = <&sd_1bit_pins>;
	pinctrl-names = "sd_default",
			"clk-gate",
			"sd_1bit_pins";
	card_type = <5>;

	bus-width = <4>;
	cap-sd-highspeed;
	max-frequency = <200000000>;
	disable-wp;

	cd-gpios = <&gpio GPIOC_6 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&vddao_3v3>;
	vqmmc-supply = <&vddao_3v3>;
};

&ethmac {
	pinctrl-0 = <&eth_led_pins>;
	pinctrl-names = "default";
	status = "okay";
	phy-handle = <&internal_ephy>;
	phy-mode = "rmii";
	keep-alive = <1>;
};

/* USB controller */
&usb_phy20 {
	status = "okay";
	portnum = <1>;
};

&usb_phy30 {
	status = "okay";
};

&crg_otg {
	status = "okay";
	controller-type = <1>; /* host mode */
};

&crg_drd {
	status = "okay";
};

/* USB controller 1 (Host) */
&usb_phy21 {
	status = "okay";
	portnum = <1>;
};

&usb_phy31 {
	status = "okay";
};

&crg {
	status = "okay";
};

/* I2C for modules - identical to U-Boot */
&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_pins2>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
};

&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_pins3>;
	pinctrl-names = "default";
	clock-frequency = <400000>;

	atecc608a: crypto@60 {
		compatible = "atmel,atecc508a";
		reg = <0x60>;
	};

	ssd1306: oled@3c {
		compatible = "solomon,ssd1306fb-i2c";
		reg = <0x3c>;
		solomon,width = <128>;
		solomon,height = <64>;
		solomon,com-invdir;
		solomon,page-offset = <0>;
		solomon,dclk-div = <1>;
		solomon,dclk-frq = <15>;
		solomon,prechargep1 = <1>;
		solomon,prechargep2 = <15>;
	};

	exp24: gpio@24 {
		compatible = "nxp,pca9535";
		reg = <0x24>;
		gpio-controller;
		#gpio-cells = <2>;

		gpio-line-names =
			"", "", "", "", "", "", "", "",
			"JOY_UP", "JOY_DOWN", "JOY_LEFT", "JOY_RIGHT",
			"JOY_CENTER", "JOY_HOME", "JOY_BACK", "";
	};
};

&i2c3 {
	status = "okay";
	pinctrl-0 = <&i2c3_pins2>;
	pinctrl-names = "default";
	clock-frequency = <400000>;

	eeprom@56 {
		compatible = "atmel,24c64";
		reg = <0x56>;
		pagesize = <32>;
	};

	gpio_exp: gpio@21 {
		compatible = "ti,tca6408";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	rtc@51 {
		compatible = "nxp,pcf85063a";
		reg = <0x51>;
	};
};

&vddcpu0 {
	status = "okay";
};

&CPU0 {
	#cooling-cells = <2>;
	operating-points-v2 = <&cpu_opp_table0>,
				<&cpu_opp_table1>,
				<&cpu_opp_table2>,
				<&cpu_opp_table3>;
};

/ {
	thermal-zones {
		soc_thermal: soc_thermal {
			polling-delay = <1000>;
			polling-delay-passive = <100>;
			sustainable-power = <1160>;
			thermal-sensors = <&p_tsensor 0>;

			trips {
				pswitch_on: trip-point@0 {
					temperature = <75000>;
					hysteresis = <5000>;
					type = "passive";
				};
				pcontrol: trip-point@1 {
					temperature = <80000>;
					hysteresis = <5000>;
					type = "passive";
				};
				pcritical: trip-point@2 {
					temperature = <100000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};

			cooling-maps {
				cpufreq_cooling_map {
					trip = <&pcontrol>;
					cooling-device = <&CPU0 0 8>;
					contribution = <1024>;
				};
			};
		};

		dmc_thermal: dmc_thermal {
			polling-delay = <500>;
			polling-delay-passive = <500>;
			thermal-sensors = <&dmc_tsensor 2>;

			trips {
				dmc_hot: trip-point@0 {
					temperature = <15000>;
					hysteresis = <5000>;
					type = "hot";
				};
			};

			cooling-maps {
				dmc_cooling_map {
					trip = <&dmc_hot>;
					cooling-device = <&dmc_tsensor 0 0>;
					contribution = <1024>;
				};
			};
		};
	};/*thermal zone end*/

	meson-cpufreq {
		cluster0 {
			/delete-property/ pdvfs_enabled;
		};
	};
};
